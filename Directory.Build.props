<Project>
  <!--
    Directory.Build.props - applies to ALL projects in this solution.

    Fixes SDK 10 trying to download net8.0 targeting packs when 8.0.29 is
    already installed locally but 8.0.30 is the "latest". We pin the runtime
    framework version so restore never demands a version not in the local cache.
  -->
  <PropertyGroup>
    <!-- Pin exact runtime pack version to what is installed (8.0.30) -->
    <RuntimeFrameworkVersion>8.0.30</RuntimeFrameworkVersion>

    <!-- Valid values for SDK 10: direct, all. 'direct' only audits direct deps. -->
    <NuGetAuditMode>direct</NuGetAuditMode>

    <!-- Suppress source link to avoid extra network calls during build -->
    <EnableSourceLink>false</EnableSourceLink>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
  </PropertyGroup>

  <!--
    Load secrets.props if it exists (local dev + CI with the file present).
    Falls back to an empty string so the project still builds without it
    (e.g. forks, open-source contributors — cloud mode just won't use a secret).
  -->
  <PropertyGroup>
    <QuireClientSecret Condition="'$(QuireClientSecret)' == ''"></QuireClientSecret>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)secrets.props"
          Condition="Exists('$(MSBuildThisFileDirectory)secrets.props')"/>

  <!--
    Generate BuildConstants.cs in the Domain project's obj folder at build time.
    This injects the secret as a C# string constant without it ever appearing
    in any committed source file.
  -->
  <Target Name="GenerateBuildConstants"
          BeforeTargets="BeforeBuild"
          Condition="'$(MSBuildProjectName)' == 'Quire.Domain'">
    <PropertyGroup>
      <_BuildConstantsPath>$(IntermediateOutputPath)BuildConstants.cs</_BuildConstantsPath>
      <_BuildConstantsContent>
namespace Quire.Domain%3B

/// &lt;summary&gt;
/// Auto-generated at build time from secrets.props. Never committed to git.
/// Contains build-time constants injected via MSBuild properties.
/// &lt;/summary&gt;
internal static class BuildConstants
{
    public const string ClientSecret = "$(QuireClientSecret)"%3B
}
      </_BuildConstantsContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(_BuildConstantsPath)"
                     Lines="$(_BuildConstantsContent)"
                     Overwrite="true"
                     WriteOnlyWhenDifferent="true"/>
    <ItemGroup>
      <Compile Include="$(_BuildConstantsPath)"/>
    </ItemGroup>
  </Target>

</Project>
